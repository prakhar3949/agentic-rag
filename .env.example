# Copy to .env and fill in real values. Every key here is read (with this exact mixed casing -
# see rag/config.py's alias-bridging loop) by at least one part of the pipeline; none are required
# to import rag/ modules, only to actually call that provider.

# Google Gemini - the generator model (rag/generation.py), and the VLM used for figure captioning
# during ingestion (notebooks/ingest_phase1.ipynb).
GOOGLE_API_key =

# Anthropic - not currently called by any rag/ module; present for parity with other providers.
ANTHROPIC_API_key =

# OpenAI - not currently called directly by any rag/ module (rag/judge.py uses the `openai`
# package's client shape, but points at Fireworks via FIREWORKS_API_key below, not this key).
openai_API_key =

# Groq - not currently called by any rag/ module; present for parity with other providers.
groq_API_key =

# Fireworks - the eval/grounding judge (rag/judge.py), DeepSeek-V4-Flash-0731. Required for
# rag/eval.py's Tier 2/3 metrics and rag/guardrails.py's grounding_node.
fireworks_API_key =

# Tavily - Phase 6's web search escalation (rag/websearch.py). Required only when a question's
# reranked top score falls below config.WEB_ESCALATION_THRESHOLD; everything else works without it
# (web_search() fails open to no results on a missing key).
TAVILY_API_key =

# LangSmith - Phase 8 observability (tracing, rag/eval.py --langsmith). Optional: rag/config.py
# defaults LANGSMITH_TRACING=true, but every LLM call still works with no key at all - tracing
# just silently has nothing to send to.
LANGSMITH_API_key =

# Only needed if your LangSmith account is provisioned outside the default US region - see
# PHASE8_NOTES.md §1 for how a wrong region reads as a confusing 403, not a connection error.
# LANGSMITH_ENDPOINT = "https://apac.api.smith.langchain.com"
